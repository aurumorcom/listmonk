# Listmonk Environment Configuration Example
# Copy this file to .env and adjust the values according to your environment.

# ==========================================
# Application Configuration
# ==========================================
# Interface and port where listmonk web server runs.
# Use 0.0.0.0:9000 to listen on all network interfaces.
LISTMONK_app__address=0.0.0.0:9000

# System Timezone
TZ=Etc/UTC

# ==========================================
# Database Configuration (PostgreSQL >= 12)
# ==========================================
LISTMONK_db__host=localhost
LISTMONK_db__port=5432
LISTMONK_db__user=listmonk
LISTMONK_db__password=listmonk
LISTMONK_db__database=listmonk
LISTMONK_db__ssl_mode=disable
LISTMONK_db__max_open=25
LISTMONK_db__max_idle=25
LISTMONK_db__max_lifetime=300s
LISTMONK_db__params=

# ==========================================
# PostgreSQL Container Credentials (for Docker)
# ==========================================
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=listmonk
POSTGRES_DB=listmonk

# ==========================================
# Initial Admin Setup (Optional)
# ==========================================
# Setting these on initial setup automatically creates the Super Admin user.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change_this_password

# ==========================================
# AI / Bifrost Integration (Optional)
# ==========================================
BIFROST_API_KEY=
BIFROST_ENDPOINT=https://litellm.aurumor.com
BIFROST_MODEL=gpt-4o-mini

# ==========================================
# WAHA WhatsApp Integration (Optional)
# ==========================================
WAHA_API_KEY=
WAHA_HOST=http://localhost:3000

# ==========================================
# Testing & VCR Cassette Mode Configuration
# ==========================================
# VCR_MODE options: "replay" (default when cassette exists), "record", "record_once"
VCR_MODE=replay
MAILHOG_HTTP_URL=http://localhost:8025
MAILHOG_SMTP_HOST=localhost

# ==========================================
# Media Uploads Configuration (S3 / Filesystem)
# ==========================================
# Provider: "filesystem" (default) or "s3"
# LISTMONK_upload__provider=s3

# S3 Configuration Settings
# LISTMONK_upload__s3__aws_default_region=us-east-1
# LISTMONK_upload__s3__aws_access_key_id=
# LISTMONK_upload__s3__aws_secret_access_key=
# LISTMONK_upload__s3__bucket=my-media-bucket
# LISTMONK_upload__s3__bucket_path=/
# LISTMONK_upload__s3__bucket_type=public
# LISTMONK_upload__s3__url=https://s3.us-east-1.amazonaws.com
# LISTMONK_upload__s3__public_url=
# LISTMONK_upload__s3__expiry=167h

# ==========================================
# OpenID Connect (OIDC) / Single Sign-On (SSO) (Optional)
# ==========================================
# Enable OpenID Connect authentication provider (e.g. Authentik, Keycloak, Google, Okta, Auth0)
# LISTMONK_security__oidc__enabled=true
# LISTMONK_security__oidc__provider_url=https://auth.example.com/application/o/listmonk/
# LISTMONK_security__oidc__provider_name=SSO
# LISTMONK_security__oidc__client_id=your-oidc-client-id
# LISTMONK_security__oidc__client_secret=your-oidc-client-secret
# LISTMONK_security__oidc__auto_create_users=true
# LISTMONK_security__oidc__default_user_role_id=1
# LISTMONK_security__oidc__default_list_role_id=1
